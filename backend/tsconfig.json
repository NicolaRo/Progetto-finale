{
    "compilerOptions":{
        "target": "ES2022",
        "module": "commonjs",
        "outDir":"./dist",
        "rootDir":"./",
        "allowJs":true,
        "checkJs": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict":false,
        "noImplicitAny": false
    },
    "include": ["**/*.ts", "**/*.js"],
    "exclude":["node_modules", "dist", "test"]
}